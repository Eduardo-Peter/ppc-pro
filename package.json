{
  "name": "ppc-pro",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node backend/index.js",
    "backend": "node backend/index.js",
    "open:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-ppc-pro.ps1",
    "stop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-ppc-pro.ps1",
    "shortcuts:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop-shortcuts.ps1",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:generate:pg": "prisma generate --schema backend/prisma/schema.postgres.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:migrate:pg": "prisma migrate dev --schema backend/prisma/schema.postgres.prisma",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma --accept-data-loss",
    "db:push:pg": "prisma db push --schema backend/prisma/schema.postgres.prisma",
    "db:seed": "node backend/prisma/seed.js",
    "db:seed:pg": "node backend/prisma/seed.js",
    "db:bootstrap:prod": "node backend/prisma/bootstrap-prod.js",
    "db:clone:to:pg": "node scripts/clone-sqlite-to-postgres.js",
    "db:clone:from:pg": "node scripts/clone-postgres-to-sqlite.js",
    "db:fix:pg:seq": "node scripts/reset-postgres-sequences.js",
    "db:clear:work:history:pg": "node scripts/clear-work-history.js",
    "db:copy:planning:to:pre:pg": "node scripts/copy-week-planning-to-pre.js",
    "docs:pdf": "node scripts/generate-marketing-manual-pdfs.js",
    "db:seed:history": "node backend/prisma/seed-dashboard-history.js",
    "desktop": "echo \"Desktop app sera reconectado apos estabilizar backend\"",
    "build": "echo \"Add build steps here\""
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pdfkit": "^0.15.2",
    "prisma": "^5.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "puppeteer-core": "^25.1.0"
  }
}
